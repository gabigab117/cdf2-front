# Copy to .env and fill in. No real production value belongs here.

# The API as the server reaches it when it renders a public page: the back end's
# development server, on 127.0.0.1 as the development proxy finds it. In the
# browser, the API stays under /api on the front end's origin.
NUXT_API_INTERNAL_URL=http://127.0.0.1:8000

# The site's own address: canonical links, Open Graph, the agenda's subscription.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# The preproduction says its data is fictitious, and is never indexed.
NUXT_PUBLIC_PREPROD=false

# The association's contact details and its village hall, fictitious here. The
# phone is the association's, never a member's. An empty value hides its line.
NUXT_PUBLIC_CONTACT_EMAIL=contact@example.org
NUXT_PUBLIC_CONTACT_PHONE=01 23 45 67 89
NUXT_PUBLIC_HALL_STREET=1 place de la Mairie
NUXT_PUBLIC_HALL_TOWN=00000 Commune

# The legal notice's details, fictitious here: read by the server alone, they
# are written into that page only, served without scripts. The publication
# director is the one person a public page names, as the law requires.
NUXT_LEGAL_PUBLICATION_DIRECTOR=Dominique Exemple
NUXT_LEGAL_OFFICE_STREET=1 place de la Mairie
NUXT_LEGAL_OFFICE_TOWN=00000 Commune
NUXT_LEGAL_HOST_NAME=Hébergeur Exemple SARL
NUXT_LEGAL_HOST_ADDRESS=1 rue de l’Exemple, 00000 Ville
NUXT_LEGAL_HOST_PHONE=01 98 76 54 32
NUXT_LEGAL_HOST_LOCATION=France
